# For existing/container PostgreSQL, supply your own complete connection URL.
# pnpm db:local:start generates this securely for a repository-local database.
DATABASE_URL=
# Required for distributed login/register limits (explicitly set in production).
REDIS_URL=redis://127.0.0.1:6379
# Must be identical across API replicas, unique per deployment sharing Redis.
RATE_LIMIT_NAMESPACE=nexos:ratelimit:auth:v1
# Required: generate 32 random bytes as hex; share securely across all API replicas.
# Example generator: openssl rand -hex 32 (never commit the generated value).
AUTH_ACCOUNT_HMAC_KEY=
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://127.0.0.1:4000
PORT=4000

# Local HTTP development. Production must explicitly set NODE_ENV=production,
# HTTPS WEB_ORIGIN and exact trusted proxy IPs; see docs/backend/https-proxy.md.
NODE_ENV=development
# Empty means no proxy trust. No hostnames, CIDRs, booleans or hop counts.
TRUSTED_PROXY_IPS=
