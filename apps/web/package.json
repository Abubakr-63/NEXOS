{
  "name": "@rom-hub/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs next dev",
    "build": "node -e \"process.env.NODE_ENV='production'; const { status } = require('node:child_process').spawnSync('next', ['build'], { stdio: 'inherit', shell: true, env: process.env }); process.exit(status ?? 0)\"",
    "start": "node ../../scripts/with-env.mjs next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@rom-hub/contracts": "workspace:*",
    "@rom-hub/ui": "workspace:*",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.23",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
